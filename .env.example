# Discord
BOT_TOKEN=

# Control Center — REQUIRED in production.
CONTROL_CENTER_KEY=
CONTROL_CENTER_ORIGIN=
BIND_HOST=127.0.0.1

# External URL allowlist (comma-separated). Add only trusted hosts you operate or explicitly trust.
GECKO_ALLOWED_EXTERNAL_HOSTS=

# yt-dlp integrity trust root. REQUIRED for production binary downloads/updates.
GECKO_YTDLP_VERSION=
GECKO_YTDLP_SHA256=

# Runtime
DEFAULT_VOLUME=100
IDLE_TIMEOUT=300
EMPTY_VOICE_TIMEOUT=180
MAX_QUEUE_SIZE=500
MAX_PLAYLIST_SIZE=100
PORT=3000

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
