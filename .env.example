# ══════════════════════════════════════════════════════════════════════════════
# GECKO MUSIC BOT — ENVIRONMENT CONFIGURATION
# Copyright © 2026 0CUONG
# Repository: https://github.com/0Cuong
# ══════════════════════════════════════════════════════════════════════════════

# ─── Required ────────────────────────────────────────────────────────────────

# Discord Bot Token
# Get this from:
# https://discord.com/developers/applications
#
# IMPORTANT:
# Never commit your real token to Git.
# Copy this file to .env and replace the placeholder.
BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"


# ─── Development ─────────────────────────────────────────────────────────────

# Guild ID for instant slash-command registration during development.
# Leave empty to use global command registration.
#
# DEV_GUILD_ID="YOUR_DISCORD_GUILD_ID"


# ─── Audio ───────────────────────────────────────────────────────────────────

# Default playback volume.
# Range: 1–100
# Default: 80
DEFAULT_VOLUME=80

# Seconds of inactivity before the bot leaves the voice channel.
# Default: 300
IDLE_TIMEOUT=300


# ─── Spotify ─────────────────────────────────────────────────────────────────

# Spotify Developer Dashboard:
# https://developer.spotify.com/dashboard/

SPOTIFY_CLIENT_ID="YOUR_SPOTIFY_CLIENT_ID_HERE"
SPOTIFY_CLIENT_SECRET="YOUR_SPOTIFY_CLIENT_SECRET_HERE"


# ─── Server ──────────────────────────────────────────────────────────────────

# HTTP port used by Gecko health checks and Prometheus metrics.
# Default: 3000
PORT=3000


# ─── Runtime ─────────────────────────────────────────────────────────────────

# Environment mode.
#
# production = strict integrity/security behaviour
# development = development behaviour
NODE_ENV=production


# ─── Integrity / Security ────────────────────────────────────────────────────

# DO NOT put secrets or private signing keys in this file.
#
# Production integrity verification should fail closed when:
# - manifest is missing
# - protected files are modified
# - manifest is invalid
# - signature verification fails
#
# Development-only emergency bypass.
# Keep disabled.
#
GECKO_ALLOW_UNVERIFIED_DEV=false


# ─── Project Identity ────────────────────────────────────────────────────────

GECKO_PROJECT_ID=GECKO-0CUONG
GECKO_AUTHOR=0CUONG
GECKO_PROJECT=Gecko Music Bot
